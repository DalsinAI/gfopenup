; GFOpenUp 0.6.14 to 0.7.0 changed the default tool of about 40 of AmigaOS 3.2.3's own
; icons (datatype descriptors, pointer presets, DOSDrivers, the Picasso96 guides...) to
; GFOpenView by mistake. Once, put each one back: from the original GFOpenTypes kept, else
; from the table of 3.2.3's own icons. Only an icon that opens GFOpenView now and whose
; original is known is touched. ENVARC:GFOpenAmiga/DefaultTools-repair.log says what.
(if (and (exists "Parts/GFOpenUp/StockDefaultTools")
         (not (exists "ENVARC:GFOpenAmiga/DefaultTools-repaired")))
    (
        (working "Putting back default tools that GFOpenUp changed by mistake")
        (if (= 0 (run (cat #tool " FIXTOOLS Parts/GFOpenUp/StockDefaultTools >>T:GFOpenUp.log")))
            (textfile (dest "ENVARC:GFOpenAmiga/DefaultTools-repaired") (append "GFOpenUp put back the default tools that 0.6.14 to 0.7.0 changed by mistake.\n")))))

; GFOpenView stands in MultiView's place (the GFOpenPrint part puts it at SYS:Utilities/MultiView and keeps
; the original in SYS:Storage/GFOpenUp-Superseded), so everything that runs MultiView (default tools, Help,
; programs, scripts) runs GFOpenView, for every kind of file a datatype reads. No icon is changed for that.
; GFOpenUp 0.7.1 did it the other way, by moving the kinds of file (ENVARC:Sys/def_<kind>) from MultiView
; to GFOpenView and leaving a marker; on this upgrade those go back to MultiView, which is GFOpenView now.
(if (and (exists "ENVARC:GFOpenAmiga/GFOpenView-switched") (exists "Parts/GFOpenUp/StockDefaultTools"))
    (
        (working "Putting back the kinds of file that 0.7.1 moved to GFOpenView")
        (if (= 0 (run (cat #tool " FIXTOOLS Parts/GFOpenUp/StockDefaultTools ALL >>T:GFOpenUp.log")))
            (delete "ENVARC:GFOpenAmiga/GFOpenView-switched"))))

; GFOpenFiles and GFOpenView on the dock, also a dock someone already has; the
; rest of it is left alone, and a button already there isn't added twice.
; (GFOpenPrefs's Dock page, SYS:Preferences/GFOpenPrefs DOCK, since the no-ROM-volume design)
; 0.8.13: over an OpenUp from before the GF names, the dock's buttons for its programs (SYS:Utilities/OpenFiles) start
; the GF ones that took their places (SYS:Utilities/GFOpenFiles) first, so none is added twice below
(if #oldup
    (run (cat #tool " OLDNAMES DOCK >>T:GFOpenUp.log")))
(if (exists "SYS:Preferences/GFOpenPrefs")
    (run "SYS:Preferences/GFOpenPrefs DOCK ADD SYS:Utilities/GFOpenFiles SYS:Utilities/GFOpenPrint/GFOpenView SAVE >>T:GFOpenUp.log"))

(set #rc (run (cat #tool " STARTUP >>T:GFOpenUp.log")))
(if (> #rc 5)
    (message "GFOpenUp couldn't write its lines in S:User-Startup. Is SYS: write-protected?"))

; GFOpenUp's programs and settings in Workbench's Tools menu from now on, not
; only after the reboot: GFOpenUpMenu starts, or the one already running (an
; upgrade) shows what was just installed
(if (exists "SYS:C/GFOpenUpMenu")
    (run "Run >NIL: SYS:C/GFOpenUpMenu"))

; (quiet): no stock "can be found in your Work: drawer" box after ours
(exit
    (cat "GFOpenUp " #version " is installed.\n\n"
         "Reboot the Amiga to start everything.\n\n"
         "To take it out again, run Uninstall-GFOpenUp from SYS:Utilities/GFOpenUp, "
         "or GFOpenUpTool UNINSTALL in a Shell.")
    (quiet))
