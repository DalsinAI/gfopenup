; GFOpenLibs (0.8.0): each library ticked is installed (an upgrade brings its newer build), and each one
; unticked that was switched on is taken out, OS 3.2's own put back (GFOpenUpTool REMOVE). The ROM ones load with
; OS 3.2's own LoadModule at the next start (S:GFOpenLibs-Startup), which loads the set again when it changes; with
; the last ROM one unticked, LoadModule REMOVE NOREBOOT lets go of its modules at the next start. The startup
; comes with the first library and goes with the last. A pack without Parts/GFOpenLibs changes nothing.
(set #libchange (<> #libs #libs0))
(if (exists "Parts/GFOpenLibs/Part")
    (
        ; the startup (S:GFOpenLibs-Startup and S:Pre-LoadModule-Startup) only with a ROM module: utility or input
        ; (0.8.7; up to 0.8.6 with any library, so mathieeedoubbas.library or OpenRexx alone armed it too)
        (if (bitand #libs 5)
            (
                (working "Installing GFOpenLibs")
                (if (> (run (cat #tool " INSTALL Parts/GFOpenLibs >>T:GFOpenUp.log")) 5)
                    (message "GFOpenLibs didn't install completely. T:GFOpenUp.log says why."))))
        (if (bitand #libs 1)
            (if (> (run (cat #tool " INSTALL Parts/GFOpenLibs/utility >>T:GFOpenUp.log")) 5)
                (message "utility.library didn't install completely. T:GFOpenUp.log says why."))
            (if (bitand #libs0 1)
                (run (cat #tool " REMOVE Parts/GFOpenLibs/utility >>T:GFOpenUp.log"))))
        (if (bitand #libs 2)
            (if (> (run (cat #tool " INSTALL Parts/GFOpenLibs/mathieeedoubbas >>T:GFOpenUp.log")) 5)
                (message "mathieeedoubbas.library didn't install completely. T:GFOpenUp.log says why."))
            (if (bitand #libs0 2)
                (run (cat #tool " REMOVE Parts/GFOpenLibs/mathieeedoubbas >>T:GFOpenUp.log"))))
        (if (bitand #libs 4)
            (if (> (run (cat #tool " INSTALL Parts/GFOpenLibs/input >>T:GFOpenUp.log")) 5)
                (message "input.device didn't install completely. T:GFOpenUp.log says why."))
            (if (bitand #libs0 4)
                (run (cat #tool " REMOVE Parts/GFOpenLibs/input >>T:GFOpenUp.log"))))
        (if (bitand #libs 8)
            (if (> (run (cat #tool " INSTALL Parts/GFOpenLibs/rexx >>T:GFOpenUp.log")) 5)
                (message "OpenRexx didn't install completely. T:GFOpenUp.log says why."))
            (if (bitand #libs0 8)
                (run (cat #tool " REMOVE Parts/GFOpenLibs/rexx >>T:GFOpenUp.log"))))
        (if (and (and (bitand #libs0 5) (not (bitand #libs 5))) (not #openkick))
            (run "C:LoadModule REMOVE NOREBOOT >>T:GFOpenUp.log"))
        (if (and (not (bitand #libs 5)) (exists "S:GFOpenLibs-Startup"))
            (run (cat #tool " REMOVE Parts/GFOpenLibs >>T:GFOpenUp.log")))
        (if #libchange
            (message "The open libraries change at the next start. With utility.library or "
                     "input.device switched on, the Amiga restarts once by itself as it starts, "
                     "so they take the ROM's place."))))

