; $VER: Uninstall-OpenUp @VERSION@ (@DATE@)
; Takes OpenUp out: every file it added goes, every file it replaced comes
; back from SYS:Storage/OpenUp-Superseded, and its lines leave
; S:User-Startup. MIT, Copyright (c) 2026 Dalsin Limited.

(set @app-name "OpenUp")
(set #tool (if (exists "C/OpenUpTool") "C/OpenUpTool" "C:OpenUpTool"))

(welcome "This takes OpenUp out and puts back everything it replaced.")

(if (askbool
        (prompt "Take OpenUp out of this Amiga?")
        (help "OpenUp keeps a list of every file it added or replaced "
              "(ENVARC:OpenAmiga/OpenUp.manifest). Uninstalling works from that list, "
              "so files OpenUp didn't install are left alone.")
        (default 1))
    (
        ; every icon OpenTypes changed (OpenUp 0.7.1 moved the kinds of file to
        ; OpenView) goes back first, while OpenTypes is still there to do it.
        ; MultiView itself comes back with the files OpenUp replaced. OpenUpTool
        ; UNINSTALL then puts back any default tool still on OpenView (FIXTOOLS ALL),
        ; for an Amiga where the record of OpenTypes' changes is gone.
        (if (exists "SYS:Prefs/OpenTypes")
            (run "SYS:Prefs/OpenTypes UNDO >T:OpenUp-uninstall.log"))
        (if (exists "ENVARC:OpenAmiga/OpenView-switched")
            (delete "ENVARC:OpenAmiga/OpenView-switched"))
        (if (exists "ENVARC:OpenAmiga/OpenFiles-place-reset")
            (delete "ENVARC:OpenAmiga/OpenFiles-place-reset"))
        ; OpenUp's entries leave the Tools menu now, before their programs go
        (if (exists "SYS:C/OpenUpMenu")
            (run "SYS:C/OpenUpMenu >NIL: QUIT"))
        ; OpenLibs (0.8.0): the open ROM libraries OS 3.2's LoadModule loaded leave memory at the next start
        (if (exists "S:OpenLibs-Startup")
            (run "C:LoadModule REMOVE NOREBOOT >>T:OpenUp-uninstall.log"))
        (set #rc (run (cat #tool " UNINSTALL >>T:OpenUp-uninstall.log")))
        ; OpenUp 0.6.12 to 0.7.4's Installer copied the OS's Sound editor into SYS:Prefs/Classic and
        ; listed the copy nowhere, so it stayed behind. With the OS's own back in SYS:Prefs, a copy of
        ; the same size goes too, and the drawer with it once it is empty. So does OpenPrefs' own old
        ; Sound editor (0.6's, "Sound 0.1 ... OpenPrefs, Dalsin Limited"), which an Amiga upgraded
        ; through 0.6 can have there instead (a lab copy of Instance-32, 12 October 2026).
        (set #oldsound 0)
        (if (= (exists "SYS:Prefs/Classic/Sound") 1)
            (
                (if (= (exists "SYS:Prefs/Sound") 1)
                    (if (= (getsize "SYS:Prefs/Classic/Sound") (getsize "SYS:Prefs/Sound")) (set #oldsound 1)))
                (if (= (run "C:Search >NIL: SYS:Prefs/Classic/Sound \"OpenPrefs, Dalsin\" QUIET") 0)
                    (set #oldsound 1))))
        (if #oldsound
            (
                (delete "SYS:Prefs/Classic/Sound" (optional "force" "nofail"))
                (if (exists "SYS:Prefs/Classic/Sound.info")
                    (delete "SYS:Prefs/Classic/Sound.info" (optional "force" "nofail")))
                (delete "SYS:Prefs/Classic" (optional "nofail"))
                (if (and (not (exists "SYS:Prefs/Classic")) (exists "SYS:Prefs/Classic.info"))
                    (delete "SYS:Prefs/Classic.info" (optional "force" "nofail")))))
        ; The dock's buttons, ENVARC:OpenDock/Dock: the Installer writes them (OpenDock SAVE on a first
        ; install, OpenDock ADD on every one), and nothing listed them, so they stayed behind. Once
        ; OpenDock itself is gone they go too; anything else in the drawer stays, and the drawer with it.
        ; Not where OpenBench is: its own dock reads the same file.
        (if (and (not (exists "SYS:C/OpenDock")) (not (exists "SYS:System/OpenBench")))
            (
                (if (exists "ENVARC:OpenDock/Dock") (delete "ENVARC:OpenDock/Dock" (optional "force" "nofail")))
                (if (exists "ENV:OpenDock/Dock") (delete "ENV:OpenDock/Dock" (optional "force" "nofail")))
                (if (exists "ENVARC:OpenDock") (delete "ENVARC:OpenDock" (optional "nofail")))
                (if (exists "ENV:OpenDock") (delete "ENV:OpenDock" (optional "nofail")))))
        (if (> #rc 5)
            (message "Some files couldn't be put back. T:OpenUp-uninstall.log "
                     "says which, and what to do."))
        ; (quiet): no stock "Installation complete ... can be found in your Work: drawer" box after ours
        (exit "OpenUp is out. Reboot the Amiga to finish." (quiet))))
