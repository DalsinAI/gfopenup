; OpenLibs (0.8.0): each library ticked is installed (an upgrade brings its newer build), and each one
; unticked that was switched on is taken out, OS 3.2's own put back (OpenUpTool REMOVE). The ROM ones load with
; OS 3.2's own LoadModule at the next start (S:OpenLibs-Startup), which loads the set again when it changes; with
; the last ROM one unticked, LoadModule REMOVE NOREBOOT lets go of its modules at the next start. The startup
; comes with the first library and goes with the last. A pack without Parts/OpenLibs changes nothing.
(set #libchange (<> #libs #libs0))
(if (exists "Parts/OpenLibs/Part")
    (
        (if #libs
            (
                (working "Installing OpenLibs")
                (if (> (run (cat #tool " INSTALL Parts/OpenLibs >>T:OpenUp.log")) 5)
                    (message "OpenLibs didn't install completely. T:OpenUp.log says why."))))
        (if (bitand #libs 1)
            (if (> (run (cat #tool " INSTALL Parts/OpenLibs/utility >>T:OpenUp.log")) 5)
                (message "utility.library didn't install completely. T:OpenUp.log says why."))
            (if (bitand #libs0 1)
                (run (cat #tool " REMOVE Parts/OpenLibs/utility >>T:OpenUp.log"))))
        (if (bitand #libs 2)
            (if (> (run (cat #tool " INSTALL Parts/OpenLibs/mathieeedoubbas >>T:OpenUp.log")) 5)
                (message "mathieeedoubbas.library didn't install completely. T:OpenUp.log says why."))
            (if (bitand #libs0 2)
                (run (cat #tool " REMOVE Parts/OpenLibs/mathieeedoubbas >>T:OpenUp.log"))))
        (if (bitand #libs 4)
            (if (> (run (cat #tool " INSTALL Parts/OpenLibs/input >>T:OpenUp.log")) 5)
                (message "input.device didn't install completely. T:OpenUp.log says why."))
            (if (bitand #libs0 4)
                (run (cat #tool " REMOVE Parts/OpenLibs/input >>T:OpenUp.log"))))
        ; 0.8.1: the disk libraries. rexxsyslib.library's replacement is a face over OS 3.2's own, which holds
        ; the ARexx interpreter, so OS 3.2's goes to LIBS:OS32 first (the copy is OpenUp's, marked in ENVARC:, and
        ; goes with it); without that copy the library is left out, since ARexx scripts would no longer run.
        (if (and (bitand #libs 128) (not (bitand #libs0 128)) (not (exists "LIBS:OS32/rexxsyslib.library")))
            (
                (if (not (exists "LIBS:OS32")) (makedir "LIBS:OS32"))
                (run "C:Copy LIBS:rexxsyslib.library LIBS:OS32/rexxsyslib.library CLONE QUIET >>T:OpenUp.log")
                (if (exists "LIBS:OS32/rexxsyslib.library")
                    (run "C:Echo >ENVARC:OpenAmiga/OpenLibs-RexxBody \"LIBS:OS32/rexxsyslib.library is OpenUp's copy\"")
                    (
                        (message "OS 3.2's rexxsyslib.library couldn't be kept in LIBS:OS32, so the open "
                                 "rexxsyslib.library was left out. T:OpenUp.log says why.")
                        (set #libs (bitand #libs 383))))))
        (set #n 0)
        (while (< #n 6)
            (
                (set #bit (shiftleft 8 #n))
                (set #lib (select #n "version" "nonvolatile" "realtime" "amigaguide" "rexxsyslib" "lowlevel"))
                (if (bitand #libs #bit)
                    (if (> (run (cat #tool " INSTALL Parts/OpenLibs/" #lib " >>T:OpenUp.log")) 5)
                        (message #lib ".library didn't install completely. T:OpenUp.log says why."))
                    (if (bitand #libs0 #bit)
                        (run (cat #tool " REMOVE Parts/OpenLibs/" #lib " >>T:OpenUp.log"))))
                (set #n (+ #n 1))))
        (if (and (not (bitand #libs 128)) (exists "ENVARC:OpenAmiga/OpenLibs-RexxBody"))
            (
                (delete "LIBS:OS32/rexxsyslib.library")
                (delete "ENVARC:OpenAmiga/OpenLibs-RexxBody")))
        (if (and (bitand #libs0 5) (not (bitand #libs 5)))
            (run "C:LoadModule REMOVE NOREBOOT >>T:OpenUp.log"))
        (if (and (not #libs) #libs0)
            (run (cat #tool " REMOVE Parts/OpenLibs >>T:OpenUp.log")))
        (if #libchange
            (message "The open libraries change at the next start. With utility.library or "
                     "input.device switched on, the Amiga restarts once by itself as it starts, "
                     "so they take the ROM's place. The libraries in LIBS: change for programs "
                     "started after the next start."))))

; Gorilla's pictures after the parts, so the drawers a part makes (SYS:Developer and its OpenGPU-SDK, from
; the OpenGPU developer files) get theirs in the same run. An icon that has its picture already is left as
; it is (OpenUpTool 0.7.5). A pack built with --no-gorilla has no Parts/GorillaIcons: the icons keep their pictures.
(if (bitand #parts 16777216)
    (if (exists "Parts/GorillaIcons/Part")
        (
            (working "Giving the system's icons Gorilla's pictures")
            (if (> (run (cat #tool " INSTALL Parts/GorillaIcons >>T:OpenUp.log")) 5)
                (message "Some icons kept their old pictures. T:OpenUp.log says why; nothing else changed.")))
        (message "This pack was made without Gorilla's icons, so the system's icons keep their pictures.")))

; OpenUp 0.6.14 to 0.7.0 changed the default tool of about 40 of AmigaOS 3.2.3's own
; icons (datatype descriptors, pointer presets, DOSDrivers, the Picasso96 guides...) to
; OpenView by mistake. Once, put each one back: from the original OpenTypes kept, else
; from the table of 3.2.3's own icons. Only an icon that opens OpenView now and whose
; original is known is touched. ENVARC:OpenAmiga/DefaultTools-repair.log says what.
(if (and (exists "Parts/OpenUp/StockDefaultTools")
         (not (exists "ENVARC:OpenAmiga/DefaultTools-repaired")))
    (
        (working "Putting back default tools that OpenUp changed by mistake")
        (if (= 0 (run (cat #tool " FIXTOOLS Parts/OpenUp/StockDefaultTools >>T:OpenUp.log")))
            (textfile (dest "ENVARC:OpenAmiga/DefaultTools-repaired") (append "OpenUp put back the default tools that 0.6.14 to 0.7.0 changed by mistake.\n")))))

; OpenView stands in MultiView's place (the OpenPrint part puts it at SYS:Utilities/MultiView and keeps
; the original in SYS:Storage/OpenUp-Superseded), so everything that runs MultiView (default tools, Help,
; programs, scripts) runs OpenView, for every kind of file a datatype reads. No icon is changed for that.
; OpenUp 0.7.1 did it the other way, by moving the kinds of file (ENVARC:Sys/def_<kind>) from MultiView
; to OpenView and leaving a marker; on this upgrade those go back to MultiView, which is OpenView now.
(if (and (exists "ENVARC:OpenAmiga/OpenView-switched") (exists "Parts/OpenUp/StockDefaultTools"))
    (
        (working "Putting back the kinds of file that 0.7.1 moved to OpenView")
        (if (= 0 (run (cat #tool " FIXTOOLS Parts/OpenUp/StockDefaultTools ALL >>T:OpenUp.log")))
            (delete "ENVARC:OpenAmiga/OpenView-switched"))))

; OpenFiles and OpenView on the dock, also a dock someone already has; the
; rest of it is left alone, and a button already there isn't added twice.
(if (exists "SYS:Prefs/OpenDock")
    (run "SYS:Prefs/OpenDock ADD SYS:Utilities/OpenFiles SYS:Utilities/OpenPrint/OpenView SAVE >>T:OpenUp.log"))

(set #rc (run (cat #tool " STARTUP >>T:OpenUp.log")))
(if (> #rc 5)
    (message "OpenUp couldn't write its lines in S:User-Startup. Is SYS: write-protected?"))

; OpenUp's programs and settings in Workbench's Tools menu from now on, not
; only after the reboot: OpenUpMenu starts, or the one already running (an
; upgrade) shows what was just installed
(if (exists "SYS:C/OpenUpMenu")
    (run "Run >NIL: SYS:C/OpenUpMenu"))

; (quiet): no stock "can be found in your Work: drawer" box after ours
(exit
    (cat "OpenUp " #version " is installed.\n\n"
         "Reboot the Amiga to start everything.\n\n"
         "To take it out again, run Uninstall-OpenUp from SYS:Utilities/OpenUp, "
         "or OpenUpTool UNINSTALL in a Shell.")
    (quiet))
