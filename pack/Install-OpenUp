; $VER: Install-OpenUp @VERSION@ (@DATE@)
; OpenUp's Installer script (C:Installer / SYS:System/Installer). Run it from
; its icon in the OpenUp drawer. What it does is DESIGN.md section 3: the
; base OS stays as shipped, every file is listed, and Uninstall-OpenUp puts
; everything back. MIT, Copyright (c) 2026 AmigaChrome Team.

(set #version "@VERSION@")
(set @app-name "OpenUp")
(set #tool "C/OpenUpTool")

(if (< (/ (getversion) 65536) 47)
    (abort "OpenUp needs AmigaOS 3.2 or later. This Amiga has an older version."))

(run (cat #tool " DETECT >NIL:"))
(set #machine (getenv "OpenUp/Machine"))
(set #summary (getenv "OpenUp/Summary"))
(set #ac (= #machine "AmigaChrome"))

; Short: the 3.2 Installer's welcome window has room for a few lines above
; its user-level buttons. The rest is a message Intermediate users see.
(welcome
    (cat "This installs OpenUp " #version ": the Open family of programs, "
         "set up to work together on AmigaOS 3.2."))
(message
    (cat #summary "\n\n"
         "Nothing of the OS is deleted: a file OpenUp replaces is kept in "
         "SYS:Storage/OpenUp-Superseded, and Uninstall-OpenUp puts it back."))

; Bits: 1 OpenSocket, 2 OpenPrint, 4 AmigaChrome sharing, 8 OpenLook, 16 backgrounds, 32 OpenTypes, 64 OpenCompress,
; 128 OpenService, 256 OpenImage, 512 OpenRTG, 1024 OpenWindows, 2048 OpenDock, 4096 OpenUp Setup, 8192 OpenMenus,
; 16384 OpenFiles, 32768 OpenPlay, 65536 OpenMUI, 131072 OpenTitle, 262144 Sound, 524288 OpenEdit,
; 1048576 OpenWrite, 2097152 OpenMail, 4194304 OpenBrowser, 8388608 OpenMulticore, 16777216 Icons (Gorilla),
; 33554432 OpenGPU, 67108864 Warp3D, 134217728 OpenDemos, 268435456 OpenCrypto, 536870912 OpenPuTTY,
; 1073741824 Tata (the last bit of this word).
; The second word, #parts2 (OpenUp 0.7.0): 1 OpenFTP, 2 Unofficial Telegram, 4 OpenGPU developer files,
; 8 OpenInput, 16 OpenTLS.
; None of them is ticked by default on a new install; an upgrade ticks those already there (below).
; AmigaChrome's defaults: everything but OpenRTG, OpenMUI, OpenMail, OpenBrowser, OpenDemos, OpenPuTTY
; and Tata (396295679); elsewhere also without OpenSocket, AmigaChrome sharing, OpenGPU and Warp3D
; (295632378). Tata stays unticked while it is 0.x (the user, 8 October 2026), and is ticked from 1.0.
; Five questions of at most nine parts: the 3.2 Installer shows nine choices a page,
; and a longer askoptions comes back with the defaults of its first pages mixed up
; (8 October 2026, on a scratch instance: 60751359 came back as 30265063). Each
; group is bits 0-8, 9-17, 18-26 and 27-30 of #parts, so the bits above keep their meaning;
; the fifth is #parts2.
(set #default (if #ac 396295679 295632378))
; An upgrade brings the parts already on this Amiga up to date, also those a new install leaves
; unticked (Tata, OpenMUI or OpenFTP picked before): each is ticked when its main file is there. A
; Novice user never sees the questions, so before 0.7.5 an upgrade left those parts at their old
; versions. Not OpenRTG: its part writes Workbench's screen mode again (ENVARC: and ENV:), which would
; undo a mode chosen since and asks Intuition to reset the Workbench screen while the Installer's
; window is open; it stays a choice (Intermediate or Expert), as before.
(if (exists "LIBS:zunemaster.library") (set #default (bitor #default 65536)))
(if (exists "SYS:Utilities/OpenMail/OpenMail") (set #default (bitor #default 2097152)))
(if (exists "SYS:Utilities/OpenBrowser/OpenBrowser") (set #default (bitor #default 4194304)))
(if (exists "SYS:Utilities/OpenDemos/OpenDemos") (set #default (bitor #default 134217728)))
(if (exists "SYS:Utilities/OpenPuTTY/OpenPuTTY") (set #default (bitor #default 536870912)))
(if (exists "SYS:C/Tata") (set #default (bitor #default 1073741824)))
(set #default2 0)
(if (exists "SYS:Utilities/OpenFTP/OpenFTP") (set #default2 (bitor #default2 1)))
(if (exists "SYS:Utilities/UnofficialTelegram") (set #default2 (bitor #default2 2)))
(if (exists "SYS:Developer/OpenGPU-SDK") (set #default2 (bitor #default2 4)))
(if (exists "LIBS:openinput.library") (set #default2 (bitor #default2 8)))
(if (exists "LIBS:opentls.library") (set #default2 (bitor #default2 16)))
(set #g1
    (askoptions
        (prompt "Which parts should OpenUp install? (1 of 5)")
        (help "OpenSocket: the Amiga's network (bsdsocket.library 4.2), through the x86 or ARM64 cores. "
              "AmigaChrome instances only.\n\n"
              "OpenPrint and OpenView: print to PDF and to printers on your network, "
              "and view pictures and documents. OpenView takes MultiView's place: whatever "
              "opened MultiView opens OpenView, and the original is kept in "
              "SYS:Storage/OpenUp-Superseded.\n\n"
              "AmigaChrome sharing: the clipboard and files, shared in and out of the Amiga. "
              "AmigaChrome instances only.\n\n"
              "OpenLook: one look for every GadTools program, on RTG screens: title bars, "
              "borders, gadgets, scrollers and window backgrounds, with a clear screen font "
              "and a little more room in the title bars. Your old settings are kept. "
              "Change it later with Look in SYS:Prefs (themes, dark mode, Lite, profiles).\n\n"
              "Backgrounds: the look's desktop as Workbench's backdrop, drawn for "
              "your screen's shape. Your old backdrop setting is kept.\n\n"
              "OpenTypes: choose the program that opens each kind of file, in Prefs.\n\n"
              "OpenCompress: open, test and extract archives and disk images (ADF, ADZ, DMS, "
              "LhA, zip, tar, gzip) from its window in SYS:Utilities, or from the Shell.\n\n"
              "OpenService: services from AmigaChrome's boards and from a Cradle you pair "
              "with (openservice.device, and Nursery to list them). Nothing goes on your "
              "network until you pair a Cradle.\n\n"
              "OpenImage: datatypes, so MultiView and every program that uses datatypes "
              "open WebP and WebM, and, through OpenService, AVIF and HEIC photos, JPEG XL, "
              "camera RAW, SVG, FLAC, Ogg, MP3, MIDI, MP4 and other video, Word and other "
              "office documents. Datatypes you already have are kept.")
        (choices "OpenSocket: networking"
                 "OpenPrint and OpenView: printing"
                 "AmigaChrome sharing: clipboard and files"
                 "OpenLook: the look"
                 "Backgrounds: the look's desktop"
                 "OpenTypes: which program opens what"
                 "OpenCompress: archives and disk images"
                 "OpenService: services from boards and Cradles"
                 "OpenImage: datatypes for today's files")
        (default (bitand #default 511))))
(set #g2
    (askoptions
        (prompt "Which parts should OpenUp install? (2 of 5)")
        (help "OpenRTG: Workbench on OpenRTG's own 16-bit screen instead of Picasso96's, "
              "on AmigaChrome's graphics board. Picasso96's monitor for that board is put "
              "aside in SYS:Storage, and Uninstall puts it back. New: off unless you pick it.\n\n"
              "OpenWindows: windows snap to edges and to each other, Amiga+Tab switches "
              "between them, the mouse wheel goes to the window under the pointer, and "
              "programs' windows open where you last left them. Windows in SYS:Prefs sets it.\n\n"
              "OpenDock: a dock at the bottom of Workbench for your programs. It starts "
              "with the buttons of ToolManager, AmiDock or AmiStart if you have one. Dock in "
              "SYS:Prefs sets it.\n\n"
              "OpenUp Setup: a few questions at the next start (theme, what starts with the "
              "machine), and in SYS:Prefs afterwards.\n\n"
              "OpenMenus: menus in the look of the theme, from the screen bar or at the pointer, "
              "and a menu for each icon and for the desktop on the right button. MagicMenu's "
              "settings are taken over; take MagicMenu out of WBStartup if you pick this. "
              "The bar can sit at any edge of the screen, and the menus work from the "
              "keyboard too (Right Amiga+Space). Menus in SYS:Prefs sets it.\n\n"
              "OpenFiles: a file manager with two panes and tabs (new). "
              "Copies are checked before anything is replaced, deleted files go to a trashcan "
              "on their own disk, and Undo puts things back. In SYS:Utilities.\n\n"
              "OpenPlay: a media player for everything the datatypes open (new): pictures as "
              "a slideshow, sounds, tunes and films, with a playlist. In SYS:Utilities.\n\n"
              "OpenMUI: zunemaster.library, MUI built from AROS's Zune for OS 3.x (a preview, "
              "off unless picked). It sits beside MUI and replaces nothing: where there is no "
              "muimaster.library it adds one that passes every call to Zune, so MUI programs "
              "run, and an installed MUI is never touched. ZuneTest in SYS:Tools shows it working.\n\n"
              "OpenTitle: AmigaChrome's logo at the title bar's left, the free chip and "
              "fast memory after Workbench's title, and the day, date and time at the right "
              "(new). Title bar in SYS:Prefs switches each, and a black border around the screen.")
        (choices "OpenRTG: Workbench without Picasso96"
                 "OpenWindows: snapping, Amiga+Tab, wheel"
                 "OpenDock: a dock for your programs"
                 "OpenUp Setup: the first-start questions"
                 "OpenMenus: menus, and right-click menus"
                 "OpenFiles: a file manager"
                 "OpenPlay: a media player"
                 "OpenMUI: MUI from Zune (preview)"
                 "OpenTitle: logo, memory and clock")
        (default (bitand (shiftright #default 9) 511))))
(set #g3
    (askoptions
        (prompt "Which parts should OpenUp install? (3 of 5)")
        (help "Sound: one place for the volume, Amiga sound (Paula) and AHI sound, with Test "
              "buttons, and a speaker on the menu bar: click for the levels, the wheel turns it "
              "up and down (new), in SYS:Prefs/OpenSound. The OS's own Sound editor stays where it is.\n\n"
              "OpenEdit: a text editor with tabs, find and replace, and colours for scripts, "
              "C and guides (new). OpenEdit in a Shell, or OpenEdit file WAIT for programs "
              "that wait for their editor.\n\n"
              "OpenWrite: a word processor for DOCX, ODT and Amiga documents, with PDF "
              "export, printing and spelling (new, version 1.0.2), in SYS:Utilities/OpenWrite; "
              "OWConvert converts documents from a Shell. Needs a 68020.\n\n"
              "OpenMail: a mail reader for IMAP mail over TLS, with Gmail, Outlook and others "
              "set up from the address (new, a preview: reading only; off unless you pick it). "
              "It needs AmiSSL 5, which AmigaOS 3.2.3 doesn't include.\n\n"
              "OpenBrowser: a web browser built on WebKit (new, a preview; off unless you pick "
              "it). It needs an FPU and is best on a 68040. It comes in its own archive, "
              "OpenUp-" #version "-OpenBrowser.lha, because it is large.\n\n"
              "OpenMulticore: lets programs hand work to the other cores of AmigaChrome's "
              "cores board, so the main CPU stays free; without a cores board the work runs "
              "on the main CPU, so it is safe on every Amiga (new).\n\n"
              "OpenGPU: opengpu.library, so programs' drawing and SDL 2 games run on the x86 or "
              "ARM64 cores and GL (Mesa) on the GPU, through AmigaChrome's graphics board; where there is "
              "no board they run on the Amiga's own CPU, as before (new). SDL 2 and GL are in "
              "LIBS:OpenGPU and load only when a program asks. OpenGPUCheck in a Shell checks it.\n\n"
              "Icons: Gorilla, AROS's icon set, as new pictures for the system's own drawers, "
              "programs and default icons (new). Each icon keeps what it does; the old "
              "pictures are kept in SYS:Storage, and Uninstall-OpenUp puts them back.\n\n"
              "Warp3D and MiniGL: Warp3D.library 5.0 and minigl.library (OpenGL 1.1) for Warp3D "
              "and MiniGL games and programs, drawn through OpenGPU "
              "(new). It needs a 68040 or 68060 with its FPU. A Warp3D.library already there "
              "(Wazp3D's, say) is kept in SYS:Storage, and Wazp3D's settings are taken over; "
              "Warp3DPrefs in a Shell changes them. W3DTest and MGLTest in SYS:Tools show them working.")
        (choices "Sound: levels and a menu bar speaker"
                 "OpenEdit: a text editor"
                 "OpenWrite: a word processor"
                 "OpenMail: mail (preview, needs AmiSSL 5)"
                 "OpenBrowser: a web browser (preview)"
                 "OpenMulticore: work on a cores board"
                 "Icons: Gorilla's pictures on the system's icons"
                 "OpenGPU: SDL on the cores, GL on the GPU (new)"
                 "Warp3D and MiniGL: 3D on OpenGPU (new, 68040)")
        (default (bitand (shiftright #default 18) 511))))
(set #g4
    (askoptions
        (prompt "Which parts should OpenUp install? (4 of 5)")
        (help "OpenDemos: Boing, Chrome Gears and Copper Tunnel, three small 3D demos in GL "
              "(new, off unless picked; needs OpenGPU and an FPU). In SYS:Utilities/OpenDemos.\n\n"
              "OpenCrypto: opencrypto.library 2.0, the sums behind secure connections (SSH's key "
              "exchanges, host keys, SHA-2, AES) for the Open programs (new). On AmigaChrome they "
              "run on the x86 or ARM64 cores, elsewhere on the Amiga's own CPU. OpenPuTTY needs it, so it comes "
              "with OpenPuTTY whatever is picked here.\n\n"
              "OpenPuTTY: PuTTY for AmigaOS 3.2, SSH, Telnet and serial terminals, with key "
              "sign-in (new, version 0.2, off unless picked). It needs a network stack "
              "(bsdsocket.library: OpenSocket, Roadshow or AmiTCP). In SYS:Utilities/OpenPuTTY.\n\n"
              "Tata: before a program runs or a file opens, Tata checks it against a list of "
              "programs and files known to crash, draw wrongly or fail on AmigaOS 3.2.3 or with "
              "OpenUp, says what is known and what helps, and asks: run it this time, always, "
              "not this time, or never (new, version 0.x, off unless picked). It never asks while "
              "the Amiga starts. Its shield sits on the title bar beside the network and sound "
              "icons; its window is Tata in SYS:Prefs, and Tata OFF in a Shell turns it off.")
        (choices "OpenDemos: three 3D demos in GL (new)"
                 "OpenCrypto: SSH and TLS sums (new)"
                 "OpenPuTTY: SSH and Telnet (new)"
                 "Tata: warns about known problems (new, 0.x)")
        (default (bitand (shiftright #default 27) 15))))
(set #g5
    (askoptions
        (prompt "Which parts should OpenUp install? (5 of 5)")
        (help "OpenFTP: FTP and FTPS in two panes, with a site manager and the Open family's "
              "look (new, off unless picked). In SYS:Utilities/OpenFTP. Plain FTP works as it is. "
              "FTPS (encrypted FTP) works with OpenTLS (opentls.library); AmiSSL 5 is still used "
              "if present. It needs a network stack (OpenSocket, Roadshow or AmiTCP).\n\n"
              "Unofficial Telegram for Amiga (Open): Telegram chats in a window on the Amiga (new, "
              "a preview, off unless picked). It isn't made by Telegram. It needs setting up before "
              "it can reach Telegram: your own Telegram API key (free, from my.telegram.org), and "
              "Telegram's service on AmigaChrome's x86 or ARM64 cores or on a paired Cradle. Until "
              "then it says what is missing, and its demo shows a made-up account. "
              "In SYS:Utilities/UnofficialTelegram.\n\n"
              "OpenGPU developer files: SDL 2's, SDL 1.2's, OpenGL's and GLA's headers and link libraries, "
              "with examples, in SYS:Developer/OpenGPU-SDK (assign OpenGPU-SDK:). For building "
              "programs on this Amiga; the programs need the OpenGPU part to run. About 7 MB.\n\n"
              "OpenInput: game controllers for every program (openinput.library, new, off unless "
              "picked). Joysticks and CD32 pads in the Amiga's ports, in one standard layout with "
              "mappings for common pads, and Gamepads in SYS:Prefs to test them, map them and "
              "choose which pad drives which port; an opt-in patch there lets older games see a "
              "modern pad. OIList in a Shell lists them. On AmigaChrome it sees the Amiga's ports "
              "for now: the pads on the x86 or ARM64 cores come with a later AmigaChrome.\n\n"
              "OpenTLS: secure connections for the Open programs (opentls.library, new): TLS 1.2 "
              "with the server's certificate checked against Mozilla's list of certificate "
              "authorities, in S:OpenTLS (put your own in ENVARC:OpenTLS/certs). OpenFTP's FTPS "
              "uses it, so it comes with OpenFTP whatever is picked here; it brings OpenCrypto, "
              "which does its sums on the x86 or ARM64 cores on AmigaChrome.")
        (choices "OpenFTP: FTP and FTPS (new)"
                 "Telegram, unofficial: needs setting up (new)"
                 "OpenGPU developer files (new)"
                 "OpenInput: game controllers (new)"
                 "OpenTLS: secure connections (new)")
        (default #default2)))
(set #parts (+ (+ (+ #g1 (shiftleft #g2 9)) (shiftleft #g3 18)) (shiftleft #g4 27)))
(set #parts2 #g5)
; OpenFTP's FTPS needs OpenTLS, and OpenTLS does its sums with OpenCrypto
(if (bitand #parts2 1) (set #parts2 (bitor #parts2 16)))
(if (bitand #parts2 16) (set #parts (bitor #parts 268435456)))
; OpenPuTTY needs OpenCrypto
(if (bitand #parts 536870912) (set #parts (bitor #parts 268435456)))

(set #look "Open light")
(set #theme "Open")
(set #back "Open-light")
(if (bitand #parts 24)
    (set #theme
        (select
            (askchoice
                (prompt "Which look?")
                (help "Open: calm and flat, with one blue accent: OpenUp's own look.\n"
                      "Glass: steel-blue glass, in the AmigaOS 4 style.\n"
                      "Graphite: graphite and steel, in the AmiKit style.\n"
                      "Ember: flat warm greys with orange, in the Ubuntu style.\n"
                      "Clear: flat, light and rounded, in the Windows 11 style.\n"
                      "Sky: Open's colours with graduated blue frames and bevelled title bar gadgets.\n"
                      "Classic: the OS's own look, drawn as it always was.\n\n"
                      "You can change it later with OpenLook THEME <name> SAVE.")
                (choices "Open" "Glass" "Graphite" "Ember" "Clear" "Sky" "Classic")
                (default 0))
            "Open" "Glass" "Graphite" "Ember" "Clear" "Sky" "Classic")))
; with a look, the windows of the look approved on 8 October 2026: no zoom
; gadget, scroll bars only when needed, and no size gadget when OpenWindows is
; picked too (it resizes from the edges; without it the size gadget stays).
; *N is a new line inside a quoted AmigaDOS argument.
(set #look (cat #theme " light*Nzoom off*Nscrollers auto"))
(if (bitand #parts 1024) (set #look (cat #look "*Nsizegadget off")))
(set #back (cat #theme "-light"))
; on AmigaChrome, its own backdrop: the theme's colours with chrome sweeps
(if #ac (set #back (cat #theme "-light-chrome")))
(if (= #theme "Classic") ((set #look "Classic light") (set #back "")))

; Each part: OpenUpTool INSTALL, its messages in T:OpenUp.log.
(run "Delete >NIL: T:OpenUp.log")
(working "Installing OpenUp")
(if (> (run (cat #tool " INSTALL Parts/OpenUp >>T:OpenUp.log")) 5)
    (abort "OpenUp's own files didn't install. T:OpenUp.log says why; nothing else changed."))
; OpenBlanker, with its show Gods and Angels, comes with every install.
(working "Installing OpenBlanker")
(if (> (run (cat #tool " INSTALL Parts/OpenBlanker >>T:OpenUp.log")) 5)
    (message "OpenBlanker didn't install completely. T:OpenUp.log says why; nothing else changed."))
; A real AGA Amiga with Picasso96's library left behind and no Picasso96 board
; running: SDL games hang at their video start. Ask to set it aside (6 Oct 2026).
(if (= (run (cat #tool " P96LEFTOVER")) 5)
    (if (askbool
            (prompt "Picasso96's library is in LIBS:, but no Picasso96 graphics board is running.\n\n"
                    "Programs that use SDL (many newer games) hang when they start their picture "
                    "while it is there.\n\nSet LIBS:Picasso96API.library aside? It is kept in "
                    "SYS:Storage/OpenUp-Superseded, and Uninstall-OpenUp puts it back.")
            (help "Choose Yes unless you are about to fit a Picasso96 graphics card. Nothing else "
                  "of Picasso96 is touched.")
            (default 1))
        (run (cat #tool " RETIRE LIBS:Picasso96API.library >>T:OpenUp.log"))))

; Tata: early, so its line comes near the top of OpenUp's block in S:User-Startup
(if (bitand #parts 1073741824)
    (
        (working "Installing Tata")
        (if (> (run (cat #tool " INSTALL Parts/Tata >>T:OpenUp.log")) 5)
            (message "Tata didn't install completely. T:OpenUp.log says why; nothing else changed."))))

(if (bitand #parts 1)
    (
        (working "Installing OpenSocket")
        (if (> (run (cat #tool " INSTALL Parts/OpenSocket >>T:OpenUp.log")) 5)
            (message "OpenSocket didn't install completely. T:OpenUp.log says why; nothing else changed."))))
(if (bitand #parts 2)
    (
        (working "Installing OpenPrint")
        (if (> (run (cat #tool " INSTALL Parts/OpenPrint >>T:OpenUp.log")) 5)
            (message "OpenPrint didn't install completely. T:OpenUp.log says why; nothing else changed."))))
(if (bitand #parts 4)
    (
        (working "Installing AmigaChromeSharing")
        (if (> (run (cat #tool " INSTALL Parts/AmigaChromeSharing >>T:OpenUp.log")) 5)
            (message "AmigaChromeSharing didn't install completely. T:OpenUp.log says why; nothing else changed."))))
(if (bitand #parts 8)
    (
        (working "Installing OpenLook")
        (if (> (run (cat #tool " INSTALL Parts/OpenLook >>T:OpenUp.log")) 5)
            (message "OpenLook didn't install completely. T:OpenUp.log says why; nothing else changed."))
        (run (cat #tool " SETTING ENVARC:OpenGadTools/Look \"" #look "\" >>T:OpenUp.log"))
        (run (cat #tool " SETTING ENV:OpenGadTools/Look \"" #look "\" >>T:OpenUp.log"))
        ; the Open programs (OpenCompress, OpenMail) draw in the same theme
        (run (cat #tool " SETTING ENVARC:OpenGadTools/Theme \"" #theme "\" >>T:OpenUp.log"))
        (run (cat #tool " SETTING ENV:OpenGadTools/Theme \"" #theme "\" >>T:OpenUp.log"))
        ; with a look: a clear screen font, and window title bars a little taller (the screen's own bar keeps the standard height)
        (if (<> #theme "Classic")
            (
                (run (cat #tool " FONT CGTriumvirate.font 13 >>T:OpenUp.log"))
                (run (cat #tool " TITLEBARS 0 2 >>T:OpenUp.log"))
                ; Workbench as a backdrop: no frame, scroll bars or size gadget on its window
                (run (cat #tool " WBBACKDROP >>T:OpenUp.log"))
                ; no fill gauge down the left border of drive windows: they get the same slim edge as any other window
                (run (cat #tool " WBGAUGE >>T:OpenUp.log"))))))

(if (bitand #parts 16)
    (
        (working "Installing the backgrounds")
        (if (> (run (cat #tool " INSTALL Parts/Backdrops >>T:OpenUp.log")) 5)
            (message "The backgrounds didn't install completely. T:OpenUp.log says why; nothing else changed."))
        (if (<> #back "")
            (run (cat #tool " BACKDROP SYS:Prefs/Presets/Backdrops/OpenUp/" #back " >>T:OpenUp.log")))))

; a pack built with --no-gorilla has no Parts/GorillaIcons: the icons keep their pictures
(if (bitand #parts 16777216)
    (if (exists "Parts/GorillaIcons/Part")
        (
            (working "Giving the system's icons Gorilla's pictures")
            (if (> (run (cat #tool " INSTALL Parts/GorillaIcons >>T:OpenUp.log")) 5)
                (message "Some icons kept their old pictures. T:OpenUp.log says why; nothing else changed.")))
        (message "This pack was made without Gorilla's icons, so the system's icons keep their pictures.")))

(if (bitand #parts 32)
    (
        (working "Installing OpenTypes")
        (if (> (run (cat #tool " INSTALL Parts/OpenTypes >>T:OpenUp.log")) 5)
            (message "OpenTypes didn't install completely. T:OpenUp.log says why; nothing else changed."))))

(if (bitand #parts 64)
    (
        (working "Installing OpenCompress")
        (if (> (run (cat #tool " INSTALL Parts/OpenCompress >>T:OpenUp.log")) 5)
            (message "OpenCompress didn't install completely. T:OpenUp.log says why; nothing else changed."))))

(if (bitand #parts 128)
    (
        (working "Installing OpenService")
        (if (> (run (cat #tool " INSTALL Parts/OpenService >>T:OpenUp.log")) 5)
            (message "OpenService didn't install completely. T:OpenUp.log says why; nothing else changed."))))

(if (bitand #parts 8388608)
    (
        (working "Installing OpenMulticore")
        (if (> (run (cat #tool " INSTALL Parts/OpenMulticore >>T:OpenUp.log")) 5)
            (message "OpenMulticore didn't install completely. T:OpenUp.log says why; nothing else changed."))))

(if (bitand #parts 256)
    (
        (working "Installing OpenImage")
        (if (> (run (cat #tool " INSTALL Parts/OpenImage >>T:OpenUp.log")) 5)
            (message "OpenImage didn't install completely. T:OpenUp.log says why; nothing else changed."))
        (if (not #ac)
            (message "On this Amiga, OpenImage's datatypes for AVIF, HEIC, MP3, FLAC, video and documents "
                     "only open files through OpenService and a Cradle paired over your network: "
                     "without one, those files don't open (\"not implemented\"). "
                     "PNG, WebP and WebM work on the Amiga itself.")
            (if (not (bitand #parts 128))
                (message "OpenImage's datatypes for AVIF, HEIC, FLAC, video and documents need OpenService "
                         "and a services card or a paired Cradle. WebP and WebM work without them.")))))

(if (bitand #parts 512)
    (
        (working "Installing OpenRTG")
